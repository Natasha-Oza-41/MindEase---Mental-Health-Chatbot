# =============================================================================
# Mental Health Chatbot - Environment Configuration
# Copy this file to .env and fill in your values
# =============================================================================

# --- LLM Configuration ---
# Get your API key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here

# Base URL — change this if using a compatible API (e.g., Azure OpenAI, Groq)
OPENAI_BASE_URL=https://api.openai.com/v1

# Model to use — gpt-4o-mini is cheapest; gpt-4o is more capable
LLM_MODEL=gpt-4o-mini

# Creativity of responses (0.0 = deterministic, 1.0 = very creative)
LLM_TEMPERATURE=0.7

# Maximum tokens in each LLM response
LLM_MAX_TOKENS=500

# --- RAG Configuration ---
# Path where the ChromaDB vector store will be persisted
VECTOR_STORE_PATH=./vector_store

# Local embedding model (downloaded automatically on first run, ~80MB)
EMBEDDING_MODEL=all-MiniLM-L6-v2

# Number of document chunks to retrieve per query
RAG_TOP_K=3

# Path to the mental health documents folder
DOCUMENTS_PATH=./data/mental_health_docs

# --- Memory Configuration ---
# Max conversation turns to keep in context (each turn = 1 user + 1 assistant message)
MAX_CONVERSATION_HISTORY=10

# --- Application Settings ---
DEBUG=false
LOG_LEVEL=INFO
